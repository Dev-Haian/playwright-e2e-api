{
  "name": "playwright-e2e-api",
  "version": "1.0.0",
  "description": "Automação de testes E2E (SauceDemo) e de API (ServeRest) com Playwright + TypeScript",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --project=e2e-desktop --project=e2e-mobile",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["playwright", "typescript", "qa", "e2e", "api-testing"],
  "author": "Haian Vilas Boas",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
